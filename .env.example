# Copy this file to .env and fill in your values. Never commit .env.
NODE_ENV=development

# Public REST API (used by the web frontend)
REST_PORT=3001

# Internal gRPC API (used by other RoleFit services, e.g. Job Discovery)
GRPC_PORT=50051

# PostgreSQL on Supabase - owned exclusively by this service.
# No other service may connect to this database directly.
#
# Supabase dashboard -> Connect -> choose a connection string:
#   - Session pooler (port 5432, IPv4)  <- recommended for this long-running server / Docker
#   - Direct connection (IPv6 only unless you buy the IPv4 add-on)
#   - Transaction pooler (port 6543)    <- meant for serverless, not needed here
# Replace [YOUR-PASSWORD] with your database password (URL-encode special characters).
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase requires SSL. Set to false only for a local Postgres without SSL.
DATABASE_SSL=true
# Optional: path to Supabase's CA certificate (Dashboard -> Database settings ->
# SSL Configuration -> Download certificate). When set, the server certificate
# is fully verified. When empty, the connection is encrypted but the
# certificate is not verified.
DATABASE_SSL_CA_PATH=

# Supabase Auth token verification (use the project URL and publishable key).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>
